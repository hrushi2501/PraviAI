# ==============================================================================
# PRAVIAI — Universal Hackathon Boilerplate Environment Variables
# ==============================================================================
# Copy this file to .env.local and populate the services you need.
# DO NOT commit real secrets to source control (.env.local is strictly gitignored).
# Optional integrations are checked on demand. Production core configuration fails closed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set an HTTPS public origin in production.
APP_RELEASE="local"
LOG_LEVEL="info"
# Optional HTTPS error collector: configure BOTH values together.
ERROR_REPORTING_URL=""
ERROR_REPORTING_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Clerk Authentication (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk"
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app/dashboard"

# ------------------------------------------------------------------------------
# 3. Supabase & PostgreSQL (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY=""
# Existing PRIVATE bucket; never create a public bucket for internal evidence.
SUPABASE_EVIDENCE_BUCKET="asset-evidence"

# Separate least-privilege runtime and signed-identity worker pools are REQUIRED in production.
DATABASE_RUNTIME_URL=""
DATABASE_IDENTITY_URL=""
# Development ONLY: explicit legacy fallback; never used in production.
ALLOW_LEGACY_DATABASE_URL="false"

# Owner tooling only: manual Drizzle migrations (never a production runtime fallback).
# Database Connection (Supabase Settings -> Database)
# DATABASE_URL uses transaction pooler (port 6543) for serverless execution
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres"
# DIRECT_URL uses direct connection (port 5432) for Drizzle migrations / studio
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Cloudinary Media Storage (https://cloudinary.com/console)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ------------------------------------------------------------------------------
# 5. Upstash Redis — Ephemeral Cache, Locks & Rate Limits (https://console.upstash.com)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. Upstash QStash — Serverless Background Jobs & Crons (https://console.upstash.com)
# ------------------------------------------------------------------------------
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ------------------------------------------------------------------------------
# 7. AI Model Providers (Optional / Plug-and-Play)
# ------------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=""

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=""

# Groq ultra-fast inference (https://console.groq.com)
GROQ_API_KEY=""

# OpenRouter multi-model router (https://openrouter.ai)
OPENROUTER_API_KEY=""

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 8. Speech & Audio AI — Deepgram STT / TTS (https://console.deepgram.com)
# ------------------------------------------------------------------------------
# Realtime speech-to-text (Nova-2/Nova-3) and text-to-speech (Aura)
DEEPGRAM_API_KEY=""

# ------------------------------------------------------------------------------
# 9. AI Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
# LangSmith (https://smith.langchain.com)
LANGCHAIN_API_KEY=""
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="pravi-ai-hackathon"

# ------------------------------------------------------------------------------
# 10. Machine Learning & Experiment Tracking (Optional)
# ------------------------------------------------------------------------------
# MLflow Tracking Server URI
MLFLOW_TRACKING_URI=""
